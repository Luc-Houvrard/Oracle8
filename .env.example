# Modèle de configuration pour Docker Compose (docker-compose.yml).
# Copie ce fichier en .env À LA RACINE du projet : cp .env.example .env
# À ne pas confondre avec backend/.env, qui sert à lancer le backend sans Docker.

# Mot de passe du compte MySQL "oracle8" (choisis-en un, il n'existe nulle part ailleurs)
DB_PASSWORD=

# Clé qui signe les tokens JWT. Génère-la avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Tentatives par quart d'heure et par IP (10 par défaut, 1000 pour lancer les tests)
LIMITE_TENTATIVES=10

# ---------- Production uniquement (laisser vide en local) ----------
# Adresse publique du site, et adresse publique de l'API
CORS_ORIGIN=
VITE_API_URL=
# 1 quand un proxy HTTPS (Caddy, nginx) est devant le backend
TRUST_PROXY=

# Compte admin créé automatiquement au démarrage s'il n'existe pas (facultatif).
# Un compte existant avec ce pseudo n'est jamais modifié.
ADMIN_PSEUDO=
ADMIN_MOTDEPASSE=
