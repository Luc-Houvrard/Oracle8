# Modèle de configuration du backend.
# Copie ce fichier en .env (cp .env.example .env), puis remplis les valeurs.
# Le fichier .env n'est jamais commité : il contient des secrets.

# ---------- Base de données MySQL ----------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=oracle8

# ---------- Sécurité ----------
# Clé qui signe les tokens JWT. Obligatoire : le serveur refuse de démarrer sans.
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------- Serveur ----------
# Port du backend (3000 par défaut)
PORT=3000

# Adresse du frontend autorisée à appeler l'API (CORS), sans "/" à la fin
CORS_ORIGIN=http://localhost:5173

# Nombre de tentatives de connexion ratées / d'inscriptions par quart d'heure et par IP.
# 10 par défaut. Mettre 1000 en développement pour lancer les tests sans être bloqué.
LIMITE_TENTATIVES=10

# Compte admin créé automatiquement au démarrage s'il n'existe pas (facultatif).
# Un compte existant avec ce pseudo n'est jamais modifié.
ADMIN_PSEUDO=
ADMIN_MOTDEPASSE=
